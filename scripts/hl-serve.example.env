# Copy to ~/.config/harnesslab/env and fill in secrets.
# hl-serve sources this file automatically (override with HL_SERVE_ENV_FILE).
#
#   mkdir -p ~/.config/harnesslab
#   cp scripts/hl-serve.example.env ~/.config/harnesslab/env
#
# Then from the repo root:
#   ./hl-serve start

export DEEPSEEK_API_KEY="your-key-here"

# Optional Anthropic-wire live smoke via DeepSeek (same key, different base URL):
# export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
# RUN_ANTHROPIC_DEEPSEEK_LIVE=1 uv run pytest tests/manual/test_anthropic_deepseek_live.py -m network -s
#
# Real Claude (when you have a key): omit ANTHROPIC_BASE_URL override, set:
# export ANTHROPIC_API_KEY="your-claude-key-here"
# export ANTHROPIC_MODEL="claude-sonnet-4-6"
#
# OpenAI Responses (GPT-5.x reasoning models):
# export OPENAI_API_KEY="sk-..."
# export OPENAI_MODEL="gpt-5-mini"
#
# Google Gemini (generateContent):
# export GOOGLE_API_KEY="your-gemini-key"
# export GEMINI_MODEL="gemini-2.5-flash"
#
# Optional web_search backend keys:
# export WEB_SEARCH_BACKEND="duckduckgo"   # or brave/tavily/serpapi
# export WEB_SEARCH_API_KEY="..."          # needed for brave/tavily/serpapi
# export BRAVE_API_KEY="..."               # optional provider-specific key
# export TAVILY_API_KEY="..."              # optional provider-specific key
# export SERPAPI_API_KEY="..."             # optional provider-specific key
#
# Optional OpenTelemetry export (JSONL trace remains source of truth):
# export HARNESSLAB_OTEL=1
# export OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318/v1/traces"
#
# Optional budget guardrails (Phase 5.10):
# export HARNESSLAB_BUDGET_ENABLED="1"
# export HARNESSLAB_BUDGET_SOFT_RATIO="0.8"
# export HARNESSLAB_BUDGET_ACTION_ON_HARD="ask_user"   # ask_user|final|error
# export HARNESSLAB_BUDGET_MAX_LLM_CALLS_PER_TURN="12"
# export HARNESSLAB_BUDGET_MAX_TOOL_CALLS_PER_TURN="16"
# export HARNESSLAB_BUDGET_MAX_TURN_WALL_TIME_MS="120000"
# export HARNESSLAB_BUDGET_MAX_SESSION_TOKENS_TOTAL="500000"
# export HARNESSLAB_BUDGET_MAX_SESSION_TOOL_CALLS_TOTAL="200"
# export HARNESSLAB_BUDGET_MAX_SESSION_WALL_TIME_MS_TOTAL="1800000"

# Optional provider overrides (also read by harnesslab run / serve):
# export DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# export DEEPSEEK_MODEL="deepseek-v4-flash"
# export DEEPSEEK_MODEL="deepseek-v4-pro"
#
# Long-term plan: non-secret defaults move to ~/.config/harnesslab/config.json
# (see docs/roadmap.md — Phase 3.5 Operator configuration).

# Optional hl-serve defaults (can also export in the same file):
# export HL_SERVE_MODEL="deepseek"
# export HL_SERVE_MODEL="anthropic"
# export HL_SERVE_MODEL="gemini"
# export HL_SERVE_PORT="8787"
# export HARNESSLAB_LOG="INFO"
#
# TS Web UI (run `cd webui && bun run build` first):
# export HARNESSLAB_WEB_UI_VERSION="ts"
