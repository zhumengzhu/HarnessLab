{
  "version": 1,
  "model": {
    "default_backend": "deepseek",
    "failover_enabled": false,
    "fallbacks": ["simple"],
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "model_name": "deepseek-v4-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "thinking": "disabled"
    },
    "anthropic": {
      "model_name": "claude-sonnet-4-6",
      "api_key_env": "ANTHROPIC_API_KEY",
      "thinking": { "mode": "adaptive", "effort": "medium" }
    },
    "openai": {
      "model_name": "gpt-5-mini",
      "api_key_env": "OPENAI_API_KEY",
      "reasoning_effort": "none"
    },
    "gemini": {
      "model_name": "gemini-2.5-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "thinking_budget": -1
    }
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 8787,
    "max_steps": 40
  },
  "policy": {
    "shell_profile": "dev",
    "python_sandbox": "disabled"
  },
  "loop": {
    "planning_mode": "off",
    "replan_after_steps": 4,
    "budget": {
      "enabled": false,
      "soft_ratio": 0.8,
      "action_on_hard": "ask_user",
      "max_session_tokens_total": 500000,
      "max_session_cost_usd_total": 5.0
    },
    "multi_agent": {
      "enabled": true
    }
  },
  "web": {
    "ui_version": "ts"
  },
  "tools": {
    "fetch_url": {
      "mode": "auto",
      "provider": "jina",
      "allowlist": ["wttr.in"],
      "deny_hosts": ["localhost", "127.0.0.1"],
      "jina_api_key_env": "JINA_API_KEY"
    },
    "web_search": {
      "backend": "ddgs",
      "max_results": 5,
      "api_key_env": "WEB_SEARCH_API_KEY"
    },
    "skills": {
      "selection_mode": "heuristic",
      "catalog_sources": ["bundled"]
    },
    "hooks": {
      "pre_tool": [
        {
          "name": "block-shell-rm",
          "type": "prompt",
          "config": {
            "tool_name_contains": "run_shell_safe",
            "action": "warn",
            "reason": "Shell tools are high-risk; double-check command intent."
          }
        }
      ],
      "post_tool": []
    }
  },
  "limits": {
    "output_bytes_cap": 65536,
    "compaction_threshold_tokens": 12000
  }
}
