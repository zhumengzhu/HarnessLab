{
  "version": 1,
  "model": {
    "default_backend": "deepseek",
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "model_name": "deepseek-v4-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "thinking": "disabled"
    }
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 8787,
    "max_steps": 20
  },
  "policy": {
    "shell_profile": "dev"
  },
  "limits": {
    "output_bytes_cap": 65536,
    "compaction_threshold_tokens": 12000
  }
}
